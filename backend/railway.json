{
  "build": {
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "startCommand": "sh -c \"uvicorn main:app --host 0.0.0.0 --port ${PORT:-8080} --forwarded-allow-ips '*' --workers 1 --timeout-keep-alive 30\"",
    "healthcheckPath": "/",
    "healthcheckTimeout": 30
  }
}
