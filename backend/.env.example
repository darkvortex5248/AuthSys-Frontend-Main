# Database Configuration (Railway provides DATABASE_URL automatically)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Redis Configuration (Railway provides REDIS_URL automatically)
REDIS_URL=redis://default:password@host:6379

# Security
SECRET_KEY=your-strong-secret-key-change-this-in-production

# Email Configuration (Optional, uses mock if not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=noreply@authsys.com
EMAILS_FROM_NAME=AuthSys
MOCK_EMAIL=true

# AI API Keys (Optional)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Turnstile (Cloudflare) -- Optional but recommended
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Stripe (Optional)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Discord OAuth
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Azure / Microsoft OAuth
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=common
